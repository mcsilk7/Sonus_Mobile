<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="80dp"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DIR"
            android:textColor="?attr/sonusTextDarkColor"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold" />
        <View
            android:id="@+id/indicatorHome"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="?attr/sonusAccentColor"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSearch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SRCH"
            android:textColor="?attr/sonusTextDarkColor"
            android:fontFamily="monospace"
            android:textSize="12sp" />
        <View
            android:id="@+id/indicatorSearch"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="?attr/sonusAccentColor"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navLibrary"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LIB"
            android:textColor="?attr/sonusTextDarkColor"
            android:fontFamily="monospace"
            android:textSize="12sp" />
        <View
            android:id="@+id/indicatorLibrary"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="?attr/sonusAccentColor"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYS"
            android:textColor="?attr/sonusTextDarkColor"
            android:fontFamily="monospace"
            android:textSize="12sp" />
        <View
            android:id="@+id/indicatorSettings"
            android:layout_width="16dp"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:background="?attr/sonusAccentColor"
            android:visibility="invisible" />
    </LinearLayout>

</LinearLayout>
