<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottomNav"
    android:layout_width="match_parent"
    android:layout_height="90dp"
    android:background="@drawable/bg_bottom_nav"
    android:elevation="12dp"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <LinearLayout
        android:id="@+id/navHome"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:id="@+id/tvNavHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_dir"
            android:textColor="?attr/sonusTextDarkColor"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textStyle="bold" />

        <View
            android:id="@+id/indicatorHome"
            android:layout_width="24dp"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:background="?attr/sonusAccentColor"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSearch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:id="@+id/tvNavSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_srch"
            android:textColor="?attr/sonusTextDarkColor"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <View
            android:id="@+id/indicatorSearch"
            android:layout_width="24dp"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:background="?attr/sonusAccentColor"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navLibrary"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:id="@+id/tvNavLibrary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_lib"
            android:textColor="?attr/sonusTextDarkColor"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <View
            android:id="@+id/indicatorLibrary"
            android:layout_width="24dp"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:background="?attr/sonusAccentColor"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navSettings"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless">

        <TextView
            android:id="@+id/tvNavSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_sys"
            android:textColor="?attr/sonusTextDarkColor"
            android:fontFamily="monospace"
            android:textSize="14sp" />

        <View
            android:id="@+id/indicatorSettings"
            android:layout_width="24dp"
            android:layout_height="2dp"
            android:layout_marginTop="8dp"
            android:background="?attr/sonusAccentColor"
            android:visibility="invisible" />
    </LinearLayout>

</LinearLayout>
