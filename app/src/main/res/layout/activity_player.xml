<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Góra -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="←"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Teraz odtwarzane"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Sonus"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/btnMore"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="⋮"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Okładka -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="28dp"
            android:padding="18dp">

            <ImageView
                android:id="@+id/imgPlayerCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_cover_placeholder"
                android:contentDescription="Okładka albumu"
                android:scaleType="centerCrop" />
        </FrameLayout>

        <!-- Tytuł -->
        <TextView
            android:id="@+id/tvPlayerSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Midnight Echo"
            android:textColor="@color/text_dark"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Artysta -->
        <TextView
            android:id="@+id/tvPlayerArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:text="Aurora"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <!-- Pasek -->
        <SeekBar
            android:id="@+id/seekBarPlayer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:progress="38"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/card_background"
            android:thumbTint="@color/accent"
            android:splitTrack="false" />

        <!-- Czasy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvCurrentTime"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1:26"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvTotalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3:45"
                android:textColor="@color/text_primary"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Sterowanie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btnShuffle"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:text="⇄"
                android:textColor="@color/text_dark"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnPrevious"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:src="@drawable/ic_skip_previous"
                android:textColor="@color/text_dark"
                android:textSize="20sp" />


            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_player_play_btn"
                android:padding="22dp"
                android:src="@drawable/ic_play"
                app:tint="@color/app_background" />

            <ImageView
                android:id="@+id/btnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:src="@drawable/ic_skip_next"
                android:textColor="@color/text_dark"
                android:textSize="20sp" />

            <LinearLayout
                android:layout_width="52dp"
                android:layout_height="60dp"
                android:gravity="center"
                android:orientation="vertical">

                <View
                    android:id="@+id/repeatIndicator"
                    android:layout_width="12dp"
                    android:layout_height="2dp"
                    android:layout_marginBottom="4dp"
                    android:background="@color/text_primary"
                    android:visibility="invisible" />

                <TextView
                    android:id="@+id/btnRepeat"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="↺"
                    android:textColor="@color/text_dark"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="≡"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>
</ScrollView>