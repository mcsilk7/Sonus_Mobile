<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/miniPlayer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:layout_marginBottom="88dp"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_mini_player"
    android:elevation="8dp"
    android:orientation="vertical">

    <!-- Rack unit top line / separator -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="?attr/sonusLineColor"
        android:layout_marginTop="12dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp" />

    <!-- Zawartość -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Okładka with border -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/sonusLineColor"
            android:padding="1dp">
            <ImageView
                android:id="@+id/miniPlayerCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/sonusCardColor"
                android:contentDescription="Okładka"
                android:scaleType="centerCrop"/>
        </FrameLayout>

        <!-- Tytuł + Artysta -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/miniPlayerTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Track Title"
                android:textColor="?attr/sonusAccentColor"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/miniPlayerArtist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Artist"
                android:textColor="?attr/sonusTextDarkColor"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Controls -->
        <ImageView
            android:id="@+id/miniPlayerPrev"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:padding="8dp"
            android:src="@drawable/ic_skip_previous"
            app:tint="?attr/sonusTextPrimaryColor"/>

        <ImageView
            android:id="@+id/miniPlayerPlay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_mini_btn"
            android:padding="10dp"
            android:src="@drawable/ic_play"
            app:tint="?attr/sonusAccentColor" />

        <ImageView
            android:id="@+id/miniPlayerNext"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:padding="8dp"
            android:src="@drawable/ic_skip_next"
            app:tint="?attr/sonusTextPrimaryColor"/>
    </LinearLayout>

    <!-- Retro Display Progress -->
    <ProgressBar
        android:id="@+id/miniPlayerProgress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:max="100"
        android:progress="35"
        android:progressTint="?attr/sonusAccentColor"
        android:progressBackgroundTint="?attr/sonusLineSoftColor" />

</LinearLayout>
