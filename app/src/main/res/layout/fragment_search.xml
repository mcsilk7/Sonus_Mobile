<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sonusBackgroundColor">

    <!-- Top Rack Header -->
    <LinearLayout
        android:id="@+id/topRackSearch"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="?attr/sonusPanelColor"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:elevation="4dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvSearchHeaderTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signal_scanner"
                android:textColor="?attr/sonusTextDarkColor"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2" />
            <TextView
                android:id="@+id/tvSearchHeaderMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/track_finder_unit"
                android:textColor="?attr/sonusAccentColor"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>

        <include layout="@layout/user_avatar" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="80dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="180dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Search Field -->
            <include layout="@layout/search_bar" />

            <!-- Results Panel -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSongsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/search_results_songs"
                    android:textColor="?attr/sonusAccentDimColor"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvSongResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <TextView
                    android:id="@+id/tvAlbumsHeader"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/search_results_albums"
                    android:textColor="?attr/sonusAccentDimColor"
                    android:textSize="13sp"
                    android:fontFamily="monospace"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvAlbumResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
