<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sonusBackgroundColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:padding="16dp"
            android:background="?attr/sonusPanelColor">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="REGISTRATION UNIT"
                android:textColor="?attr/sonusTextDarkColor"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:letterSpacing="0.3" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="NEW_IDENTITY"
                android:textColor="?attr/sonusAccentColor"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Register Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="?attr/sonusCardColor">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATA_ENTRY"
                android:textColor="?attr/sonusTextDarkColor"
                android:fontFamily="monospace"
                android:textSize="12sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="OPERATOR_ID"
                android:textColor="?attr/sonusTextPrimaryColor"
                android:fontFamily="monospace"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/etRegisterName"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="unique name"
                android:textColor="?attr/sonusAccentColor"
                android:textColorHint="?attr/sonusTextFaintColor"
                android:fontFamily="monospace"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="SECURE_PASS"
                android:textColor="?attr/sonusTextPrimaryColor"
                android:fontFamily="monospace"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/etRegisterPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="********"
                android:inputType="textPassword"
                android:textColor="?attr/sonusAccentColor"
                android:textColorHint="?attr/sonusTextFaintColor"
                android:fontFamily="monospace"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_auth_button"
                android:gravity="center"
                android:text="INITIALIZE_ACCOUNT"
                android:textColor="?attr/sonusBackgroundColor"
                android:fontFamily="monospace"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvGoToLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="BACK_TO_LOGIN_INTERFACE"
            android:textColor="?attr/sonusAccentDimColor"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>
</ScrollView>
