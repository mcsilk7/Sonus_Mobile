<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playlistItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_settings_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Rack unit indicator -->
    <View
        android:layout_width="4dp"
        android:layout_height="32dp"
        android:background="?attr/sonusAccentDimColor"
        android:layout_marginEnd="12dp" />

    <!-- 2x2 Grid okładek with border -->
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="?attr/sonusLineColor"
        android:padding="1dp">

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:columnCount="2"
            android:rowCount="2">

            <ImageView
                android:id="@+id/imgPlaylistCover1"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_cover_placeholder"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/imgPlaylistCover2"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_cover_placeholder"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/imgPlaylistCover3"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_cover_placeholder"
                android:scaleType="centerCrop" />

            <ImageView
                android:id="@+id/imgPlaylistCover4"
                android:layout_width="27dp"
                android:layout_height="27dp"
                android:background="@drawable/bg_cover_placeholder"
                android:scaleType="centerCrop" />
        </GridLayout>
    </FrameLayout>

    <!-- Nazwa + liczba utworów -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlaylistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/unit_id_prefix"
            android:textColor="?attr/sonusAccentColor"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlaylistCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="monospace"
            android:text="@string/description_pending"
            android:textColor="?attr/sonusTextDarkColor"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvPlaylistLoad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="monospace"
        android:text="@string/double_colon_load"
        android:textColor="?attr/sonusAccentDimColor"
        android:textSize="11sp" />

</LinearLayout>
