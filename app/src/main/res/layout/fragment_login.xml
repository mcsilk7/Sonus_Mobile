<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sonusBackgroundColor"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <!-- Studio Branding Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:padding="16dp"
            android:background="?attr/sonusPanelColor">
            <TextView
                android:id="@+id/tvLoginTop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/access_control"
                android:textColor="?attr/sonusTextDarkColor"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:letterSpacing="0.3" />
            <TextView
                android:id="@+id/tvLoginMain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="monospace"
                android:text="@string/app_name"
                android:textColor="?attr/sonusAccentColor"
                android:textSize="48sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Login Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="vertical"
            android:padding="24dp"
            android:background="?attr/sonusCardColor">

            <TextView
                android:id="@+id/tvLoginStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/station_login_v2"
                android:textColor="?attr/sonusTextDarkColor"
                android:fontFamily="monospace"
                android:textSize="12sp" />

            <!-- Input Fields -->
            <TextView
                android:id="@+id/tvLoginUserLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/user_id_label"
                android:textColor="?attr/sonusTextPrimaryColor"
                android:fontFamily="monospace"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/etLoginEmail"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="@string/hint_enter_id"
                android:textColor="?attr/sonusAccentColor"
                android:textColorHint="?attr/sonusTextFaintColor"
                android:fontFamily="monospace"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvLoginPassLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/pass_code_label"
                android:textColor="?attr/sonusTextPrimaryColor"
                android:fontFamily="monospace"
                android:textSize="13sp" />
            <EditText
                android:id="@+id/etLoginPassword"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_auth_input"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:hint="@string/hint_stars"
                android:inputType="textPassword"
                android:textColor="?attr/sonusAccentColor"
                android:textColorHint="?attr/sonusTextFaintColor"
                android:fontFamily="monospace"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_auth_button"
                android:gravity="center"
                android:text="@string/authorize"
                android:textColor="?attr/sonusBackgroundColor"
                android:fontFamily="monospace"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvGoToRegister"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/create_new_station_account"
            android:textColor="?attr/sonusAccentDimColor"
            android:fontFamily="monospace"
            android:textSize="13sp"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground" />

    </LinearLayout>
</ScrollView>
