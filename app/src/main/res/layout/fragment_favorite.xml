<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/sonusBackgroundColor">

    <!-- Top Rack Header -->
    <LinearLayout
        android:id="@+id/topRackFavorite"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="?attr/sonusPanelColor"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:elevation="4dp">

        <TextView
            android:id="@+id/btnBackFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="@string/nav_esc"
            android:textColor="?attr/sonusAccentColor"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/signal_archive"
                android:textColor="?attr/sonusTextDarkColor"
                android:textSize="10sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.2" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/favorite_storage"
                android:textColor="?attr/sonusAccentColor"
                android:textSize="18sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/tvFavoriteOfflineStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/offline_mode_tag"
                android:textColor="?attr/sonusStatusRed"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:visibility="gone" />
        </LinearLayout>

        <include layout="@layout/user_avatar" />
    </LinearLayout>

    <!-- Control Bar -->
    <LinearLayout
        android:id="@+id/controlBarFavorite"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="80dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/sonusPanelColor"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvFavoriteDataStreamLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/data_stream_list"
            android:textColor="?attr/sonusTextDarkColor"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="?attr/sonusLineSoftColor" />

        <TextView
            android:id="@+id/btnSortFavorite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/sort_bracket"
            android:textColor="?attr/sonusAccentDimColor"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFavoriteSongsFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="116dp"
        android:padding="16dp"
        android:clipToPadding="false"
        android:paddingBottom="180dp" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabPlayFavorites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="100dp"
        android:contentDescription="@string/btn_play"
        android:backgroundTint="?attr/sonusAccentColor"
        android:src="@drawable/ic_play"
        app:tint="?attr/sonusBackgroundColor"
        app:fabSize="normal"
        app:elevation="8dp" />

</FrameLayout>
