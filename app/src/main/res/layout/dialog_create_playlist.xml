<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/bg_dialog">

    <TextView
        android:id="@+id/tvCreatePlaylistTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/init_new_unit"
        android:textColor="?attr/sonusAccentColor"
        android:textSize="20sp"
        android:fontFamily="monospace"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvCreatePlaylistSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/assign_label_identifier"
        android:textColor="?attr/sonusTextDarkColor"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:layout_marginBottom="8dp"/>

    <EditText
        android:id="@+id/etPlaylistName"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_auth_input"
        android:hint="@string/hint_enter_name_technical"
        android:textColor="?attr/sonusTextPrimaryColor"
        android:textColorHint="?attr/sonusTextFaintColor"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:fontFamily="monospace"
        android:inputType="textCapSentences"
        android:layout_marginBottom="24dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/abort_bracket"
                android:textColor="?attr/sonusTextDarkColor"
                android:textSize="14sp"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:layout_marginEnd="8dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackground"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnConfirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/initialize"
                android:textColor="?attr/sonusBackgroundColor"
                android:background="@drawable/bg_auth_button"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:fontFamily="monospace"
                android:textAllCaps="false"
                android:textStyle="bold"/>
    </LinearLayout>

</LinearLayout>
