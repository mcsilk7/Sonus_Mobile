<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="160dp"
    android:layout_height="wrap_content"
    android:layout_marginEnd="16dp"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_item"
    android:padding="8dp">

    <!-- The "Tape Box" Front -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="?attr/sonusLineColor"
        android:padding="2dp">

        <ImageView
            android:id="@+id/imgTapeCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="?attr/sonusBackgroundColor" />

        <!-- Static "Sticker" Label -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:background="@color/studio_sticker_bg"
            android:orientation="vertical"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">
            <TextView
                android:id="@+id/tvReelId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reel_id_prefix"
                android:textColor="@color/studio_sticker_text"
                android:textSize="7sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Technical Metadata -->
    <TextView
        android:id="@+id/tvTapeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="@string/track_name_placeholder"
        android:textColor="?attr/sonusAccentColor"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTapeArtist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:text="@string/artist_id_placeholder"
        android:textColor="?attr/sonusTextDarkColor"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="?attr/sonusAccentDimColor" />

        <TextView
            android:id="@+id/tvTapeDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:text="@string/log_date_prefix"
            android:textColor="?attr/sonusTextFaintColor"
            android:textSize="8sp" />
    </LinearLayout>

</LinearLayout>
