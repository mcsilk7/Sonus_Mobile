<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/songItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="1dp"
    android:background="?attr/sonusCardColor"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Small Tape/Disk Icon style Cover -->
    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="?attr/sonusLineColor"
        android:padding="1dp">
        <ImageView
            android:id="@+id/imgCover"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Okładka"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <!-- Tytuł + Artysta -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:maxLines="1"
            android:text="@string/track_name_placeholder"
            android:textColor="?attr/sonusAccentColor"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSongArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/artist_id_placeholder"
            android:textColor="?attr/sonusTextDarkColor"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Retro Display Duration -->
    <TextView
        android:id="@+id/tvSongDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:text="@string/time_placeholder"
        android:fontFamily="monospace"
        android:textColor="?attr/sonusTextDarkColor"
        android:textSize="13sp" />

    <!-- Controls -->
    <TextView
        android:id="@+id/btnAddToPlaylist"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="+"
        android:textColor="?attr/sonusTextDarkColor"
        android:textSize="22sp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

    <ImageView
        android:id="@+id/btnFavorite"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:src="@drawable/ic_favorite"
        app:tint="?attr/sonusTextDarkColor"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless" />

</LinearLayout>
