<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/albumItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_home_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Okładka albumu -->
    <ImageView
        android:id="@+id/imgAlbumCover"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:background="@drawable/bg_cover_placeholder"
        android:contentDescription="Okładka albumu"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvAlbumName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:text="Album"
        android:textColor="@color/text_dark"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAlbumArtist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:text="Artysta"
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

</LinearLayout>